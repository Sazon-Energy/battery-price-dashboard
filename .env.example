# Supabase (browser-safe, RLS-governed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server-only, bypasses RLS - never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Admin login password (server-only). Exchanged once at /api/login for a session cookie.
ADMIN_PASSWORD=

# Random secret used to sign session cookies (server-only). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Anthropic API key, used by the optional LLM-based spec extraction fallback
ANTHROPIC_API_KEY=

# Legacy/unused - present in some environments but not referenced by app code
DATABASE_URL=
